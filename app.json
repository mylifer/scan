{
  "expo": {
    "name": "Fiş Tarayıcı",
    "slug": "fis-tarayici",
    "scheme": "fistarayici",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.adba.fistarayici",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.adba.fistarayici",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static",
      "name": "Fiş Tarayıcı",
      "shortName": "Fiş Tarayıcı",
      "themeColor": "#F4F6FB",
      "backgroundColor": "#F4F6FB"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "POS fişlerinizi taramak için kamera erişimine ihtiyaç var.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Galerideki fiş fotoğraflarını seçebilmek için fotoğraflarınıza erişim gerekiyor.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "baseUrl": "/scan"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4446685-6bd2-4e1c-b0d0-cb1c025e1905"
      }
    },
    "owner": "daytonaa",
    "updates": {
      "url": "https://u.expo.dev/e4446685-6bd2-4e1c-b0d0-cb1c025e1905"
    }
  }
}
